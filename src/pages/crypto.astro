---
/**
 * Crypto/Trending Page
 *
 * Layer 0: Static HTML layout with trending tokens
 * Layer 1: React Islands (LiveTicker, Charts - future)
 */
import Base from '../layouts/Base.astro'
import Header from '../components/static/Header.astro'
import Footer from '../components/static/Footer.astro'
import TokenCard from '../components/static/TokenCard.astro'
import LiveTicker from '../components/islands/LiveTicker'
import MatrixRain from '../components/magic/MatrixRain'

// Fictional example tokens. None of these are real projects: the names,
// prices and safety scores are made up to show the layout. Never put a safety
// score next to a real token name, ticker or address.
const trendingTokens = [
  { name: 'Example Frog', symbol: 'EX-FROG', price: '$0.0245', change: 12.5, safetyScore: 98, volume: '$124K', marketCap: '$8.4M', isTrending: true },
  { name: 'Example Seal', symbol: 'EX-SEAL', price: '$0.0089', change: 45.2, safetyScore: 85, volume: '$42K', marketCap: '$890K', isTrending: true },
  { name: 'Example Rocket', symbol: 'EX-ROCKET', price: '$0.00042', change: -3.2, safetyScore: 72, volume: '$18K', marketCap: '$420K' },
  { name: 'Example Cat', symbol: 'EX-CAT', price: '$0.0037', change: 8.7, safetyScore: 78, volume: '$12K', marketCap: '$370K' },
  { name: 'Example Whale', symbol: 'EX-WHALE', price: '$0.0046', change: -1.2, safetyScore: 82, volume: '$8.5K', marketCap: '$460K' },
  { name: 'Example Moon', symbol: 'EX-MOON', price: '$0.000012', change: 156.8, safetyScore: 45, volume: '$2.4K', marketCap: '$12K', isTrending: true, isNew: true },
  { name: 'Example Pixel', symbol: 'EX-PIXEL', price: '$0.089', change: 15.6, safetyScore: 88, volume: '$5.2K', marketCap: '$89K' },
  { name: 'Example Comet', symbol: 'EX-COMET', price: '$0.0042', change: 8.3, safetyScore: 65, volume: '$1.8K', marketCap: '$42K' },
  { name: 'Example Lily', symbol: 'EX-LILY', price: '$0.0015', change: -6.2, safetyScore: 58, volume: '$980', marketCap: '$15K' },
  { name: 'Example Pond', symbol: 'EX-POND', price: '$0.023', change: 21.1, safetyScore: 72, volume: '$3.1K', marketCap: '$23K', isTrending: true },
  { name: 'Example Lotus', symbol: 'EX-LOTUS', price: '$0.0156', change: 124.5, safetyScore: 92, volume: '$4.8K', marketCap: '$156K', isNew: true, isTrending: true },
  { name: 'Example Tadpole', symbol: 'EX-TADPOLE', price: '$0.00034', change: -12.4, safetyScore: 38, volume: '$420', marketCap: '$3.4K' },
]

// What the page is showing, not market statistics
const marketStats = [
  { label: 'Tokens Shown', value: String(trendingTokens.length) },
  { label: 'Token Data', value: 'Sample' },
  { label: 'Prices', value: 'Not live' },
  { label: 'Safety Scores', value: 'Examples' },
]
---

<Base title="Trending">
  <MatrixRain client:idle />

  <div class="min-h-screen flex flex-col relative z-10">
    <Header currentPath="/crypto" />
    <LiveTicker client:load />

    <main class="flex-1 container-app py-8">
      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black mb-2" style="font-family: var(--font-display);">
            <span class="text-primary">📈</span> TRENDING TOKENS
          </h1>
          <p class="text-muted-foreground">Example token cards: fictional tokens, sample data</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge badge-warning font-bold">EXAMPLE TOKENS</span>
          <span class="px-3 py-1 bg-primary/20 border border-primary/50 rounded text-xs font-mono">
            {trendingTokens.length} TOKENS
          </span>
        </div>
      </div>

      <!-- Market Stats -->
      <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        {marketStats.map(stat => (
          <div class="card-terminal">
            <div class="text-xs text-muted-foreground uppercase tracking-wider">{stat.label}</div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-primary mt-1">{stat.value}</div>
          </div>
        ))}
      </section>

      <!-- Filters -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-bold">
          ALL
        </button>
        <button class="px-4 py-2 border border-border rounded-md text-sm font-bold hover:border-primary/50 transition-colors">
          🔥 HOT
        </button>
        <button class="px-4 py-2 border border-border rounded-md text-sm font-bold hover:border-primary/50 transition-colors">
          🆕 NEW
        </button>
        <button class="px-4 py-2 border border-border rounded-md text-sm font-bold hover:border-primary/50 transition-colors">
          💎 GEMS
        </button>
        <button class="px-4 py-2 border border-border rounded-md text-sm font-bold hover:border-primary/50 transition-colors">
          ⚠️ RISKY
        </button>
      </div>

      <!-- Token Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {trendingTokens.map(token => (
          <TokenCard {...token} />
        ))}
      </div>

      <!-- Load More -->
      <div class="text-center mt-8">
        <button class="btn btn-secondary px-8">
          Load More Tokens
        </button>
      </div>
    </main>

    <Footer />
  </div>
</Base>
