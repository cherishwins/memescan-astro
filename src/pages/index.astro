---
/**
 * Home Page - MemeScan Scanner
 *
 * Layer 0: Static HTML (this file)
 * Layer 1: React Islands (LiveTicker, etc.)
 * Layer 2: Three.js (MatrixRain - ambient)
 */
import Base from '../layouts/Base.astro'
import Header from '../components/static/Header.astro'
import Footer from '../components/static/Footer.astro'
import HeroBanner from '../components/static/HeroBanner.astro'
import TokenCard from '../components/static/TokenCard.astro'
import StatCard from '../components/static/StatCard.astro'

// Layer 1: React Islands
import LiveTicker from '../components/islands/LiveTicker'

// Layer 2: Three.js Magic
import MatrixRain from '../components/magic/MatrixRain'

// Fictional example tokens. None of these are real projects: the names,
// prices and safety scores are made up to show the layout. Never put a safety
// score next to a real token name, ticker or address.
const trendingTokens = [
  { name: 'Example Frog', symbol: 'EX-FROG', price: '$0.00042', change: 15.4, safetyScore: 85, volume: '$1.2M', marketCap: '$4.2M', isTrending: true },
  { name: 'Example Seal', symbol: 'EX-SEAL', price: '$0.0012', change: -5.2, safetyScore: 72, volume: '$890K', marketCap: '$2.1M' },
  { name: 'Example Rocket', symbol: 'EX-ROCKET', price: '$0.00089', change: 42.1, safetyScore: 45, volume: '$2.4M', marketCap: '$8.5M', isTrending: true },
  { name: 'Example Cat', symbol: 'EX-CAT', price: '$0.0034', change: 8.7, safetyScore: 91, volume: '$560K', marketCap: '$1.8M' },
  { name: 'Example Whale', symbol: 'EX-WHALE', price: '$0.0156', change: 124.5, safetyScore: 88, volume: '$3.2M', marketCap: '$12.4M', isNew: true, isTrending: true },
  { name: 'Example Moon', symbol: 'EX-MOON', price: '$0.00001', change: -89.2, safetyScore: 12, volume: '$45K', marketCap: '$120K' },
]

const newLaunches = [
  { name: 'Example Lily', symbol: 'EX-LILY', price: '$0.00001', change: 0, safetyScore: 50, isNew: true },
  { name: 'Example Pond', symbol: 'EX-POND', price: '$0.00025', change: 15.2, safetyScore: 65, isNew: true },
  { name: 'Example Tadpole', symbol: 'EX-TADPOLE', price: '$0.00008', change: -12.5, safetyScore: 38, isNew: true },
]
---

<Base title="Scanner">
  <!-- Layer 2: Ambient magic (loads on idle, respects motion prefs) -->
  <MatrixRain client:idle />

  <div class="min-h-screen flex flex-col relative z-10">
    <!-- Layer 0: Static Header -->
    <Header currentPath="/" />

    <!-- Layer 1: Sample price ticker (loads immediately, above fold) -->
    <LiveTicker client:load />

    <main class="flex-1">
      <!-- Layer 0: Hero Banner -->
      <HeroBanner />

      <!-- Layer 0: Trending Tokens Grid -->
      <section class="container-app py-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2">
            <span class="text-2xl">🔥</span>
            TRENDING PREVIEW
          </h2>
          <span class="badge badge-warning font-bold whitespace-nowrap">EXAMPLES</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {trendingTokens.map(token => (
            <TokenCard {...token} />
          ))}
        </div>
      </section>

      <!-- Layer 0: Stats Section -->
      <section class="container-app py-8 border-t border-border">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <span class="text-2xl">📊</span>
          PREVIEW STATUS
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <StatCard label="Token Scanner" value="Preview" variant="default" />
          <StatCard label="Rug Checks" value="Not live" variant="warning" />
          <StatCard label="Token Data" value="Sample" variant="success" />
          <StatCard label="Prices" value="Not live" variant="default" />
        </div>
      </section>

      <!-- Layer 0: New Launches -->
      <section class="container-app py-8 border-t border-border">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2">
            <span class="text-2xl">🆕</span>
            NEW LAUNCHES
          </h2>
          <a href="/crypto" class="text-sm text-primary hover:underline">View all →</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {newLaunches.map(token => (
            <TokenCard {...token} />
          ))}
        </div>
      </section>

      <!-- Layer 0: Quick Actions -->
      <section class="container-app py-8 border-t border-border">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="/cryptokart" class="card-terminal text-center hover:border-chart-5/50 group">
            <span class="text-3xl mb-2 block group-hover:scale-110 transition-transform">🎮</span>
            <span class="font-bold text-sm">CRYPTOKART</span>
            <p class="text-xs text-muted-foreground mt-1">Race & Win</p>
          </a>
          <a href="/rewards" class="card-terminal text-center hover:border-destructive/50 group">
            <span class="text-3xl mb-2 block group-hover:scale-110 transition-transform">🔥</span>
            <span class="font-bold text-sm">REWARDS</span>
            <p class="text-xs text-muted-foreground mt-1">Earn Points</p>
          </a>
          <a href="/portfolio" class="card-terminal text-center hover:border-accent/50 group">
            <span class="text-3xl mb-2 block group-hover:scale-110 transition-transform">📋</span>
            <span class="font-bold text-sm">WATCHLIST</span>
            <p class="text-xs text-muted-foreground mt-1">Track Tokens</p>
          </a>
          <a href="https://t.me/MemeScanTON_bot" target="_blank" class="card-terminal text-center hover:border-primary/50 group">
            <span class="text-3xl mb-2 block group-hover:scale-110 transition-transform">🤖</span>
            <span class="font-bold text-sm">TELEGRAM BOT</span>
            <p class="text-xs text-muted-foreground mt-1">Open in Telegram</p>
          </a>
        </div>
      </section>
    </main>

    <!-- Layer 0: Static Footer -->
    <Footer />
  </div>
</Base>
